# All settings are REQUIRED unless marked optional (no defaults are applied).
# CLI flags override: --port= --host= --cwd= --pi-bin= --history-limit= --pi-args=
PI_WRAPPER_PORT=4321
PI_WRAPPER_HOST=127.0.0.1
# Working directory the pi agent operates in
PI_WRAPPER_CWD=/absolute/path/to/your/project
# pi executable (name on PATH or absolute path)
PI_WRAPPER_PI_BIN=pi
# Max events kept in memory for replay to newly opened pages
PI_WRAPPER_HISTORY_LIMIT=5000
# Optional: extra pi CLI arguments (whitespace separated), e.g. --provider anthropic --model claude-sonnet-4-5
PI_WRAPPER_PI_ARGS=
# Optional: env overrides applied ONLY to the pi child process (comma separated KEY=VALUE).
# pi's Azure provider uses the /openai/v1 endpoint, which only accepts api-version "v1"/"preview";
# a dated version such as 2025-04-01-preview in your shell causes "400 API version not supported".
PI_WRAPPER_PI_ENV=AZURE_OPENAI_API_VERSION=v1
